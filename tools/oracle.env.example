# Local Oracle connection for tools/apply-sql.cmd
# Copy this file to tools/oracle.env and fill in local values.
#
# tools/oracle.env is ignored by Git and must never be committed.

ORA_USER=XXI
ORA_PASSWORD=change_me

# TNS alias from tnsnames.ora, despite the historical ORA_SID name.
ORA_SID=DEV8I

# Optional. If omitted, sqlplus.exe is searched in PATH.
ORACLE_IC_HOME=C:\Oracle\instantclient_19_33

# Optional. Instant Client otherwise uses its default network\admin directory.
# ORA_TNS_ADMIN=C:\Oracle\instantclient_19_33\network\admin

# Repository SQL files are UTF-8.
ORA_NLS_LANG=.AL32UTF8
